#!/usr/bin/env ruby
# frozen_string_literal: true

require 'yaml'
require 'digest'
require 'date'
require 'fileutils'
require 'tempfile'

class InvalidConstitution < StandardError; end

class Constitution
  CATEGORIES = %w[governance authority safety workflow repository verification].freeze
  STATUSES = %w[draft active superseded retired].freeze
  FIELDS = %w[schemaVersion kind id revision title category status scope createdOn createdBy extends supersedes approvedOn approvedBy installationApproval].freeze

  def initialize(root)
    @root = File.expand_path(root)
    @base = File.join(@root, '.harness')
    @rules = []
  end

  def relative(path)
    path.delete_prefix("#{@root}/")
  end

  def fail_at(path, message, rule = nil)
    raise InvalidConstitution, "#{relative(path)}#{rule ? " [#{rule}]" : ''}: #{message}"
  end

  def yaml_file(path)
    fail_at(path, 'missing file') unless File.file?(path)
    fail_at(path, 'symlink is not allowed') if File.symlink?(path)
    data = YAML.safe_load(File.binread(path), permitted_classes: [Date], aliases: false)
    fail_at(path, 'expected a YAML mapping') unless data.is_a?(Hash)
    data
  rescue Psych::Exception => e
    fail_at(path, "invalid YAML: #{e.message.lines.first.strip}")
  end

  def exact_keys(value, allowed, required, path)
    fail_at(path, "unknown fields: #{(value.keys - allowed).sort.join(', ')}") unless (value.keys - allowed).empty?
    fail_at(path, "missing fields: #{(required - value.keys).sort.join(', ')}") unless (required - value.keys).empty?
  end

  def load_inputs
    manifest_path = File.join(@base, 'manifest.yaml')
    schema_path = File.join(@base, 'constitution/schema.yaml')
    @manifest = yaml_file(manifest_path)
    exact_keys(@manifest, %w[manifestVersion frameworkVersion rulesetVersion frameworkDigest script limits installationApproval], %w[manifestVersion frameworkVersion rulesetVersion frameworkDigest script limits installationApproval], manifest_path)
    fail_at(manifest_path, 'unsupported manifestVersion') unless @manifest['manifestVersion'] == 1
    %w[frameworkVersion rulesetVersion].each { |k| fail_at(manifest_path, "invalid #{k}") unless @manifest[k].is_a?(String) && @manifest[k].match?(/\A\d+\.\d+\.\d+\z/) }
    fail_at(manifest_path, 'invalid frameworkDigest') unless @manifest['frameworkDigest'].is_a?(String) && @manifest['frameworkDigest'].match?(/\A[a-f0-9]{64}\z/)
    fail_at(manifest_path, 'invalid script') unless @manifest['script'] == '.harness/scripts/validate-constitution' && File.executable?(File.join(@root, @manifest['script']))
    fail_at(manifest_path, 'installation approval must identify the pinned ruleset') unless @manifest['installationApproval'].is_a?(Hash) && @manifest['installationApproval']['approvedBy'] == 'user' && @manifest['installationApproval']['rulesetVersion'] == @manifest['rulesetVersion'] && date?(@manifest['installationApproval']['approvedOn'])
    limits = @manifest['limits']
    fail_at(manifest_path, 'invalid limits') unless limits.is_a?(Hash) && limits.keys.sort == %w[default frontmatterBytes workflow].sort
    %w[default workflow].each do |name|
      item = limits[name]
      fail_at(manifest_path, "invalid #{name} limits") unless item.is_a?(Hash) && item.keys.sort == %w[bodyBytes bodyWords] && item.values.all? { |v| v.is_a?(Integer) && v.positive? }
    end
    fail_at(manifest_path, 'invalid frontmatterBytes') unless limits['frontmatterBytes'].is_a?(Integer) && limits['frontmatterBytes'].positive?

    @schema = yaml_file(schema_path)
    exact_keys(@schema, %w[schemaVersion kind categories statuses frontmatterFields requiredFields requiredSections scopeGlob], %w[schemaVersion kind categories statuses frontmatterFields requiredFields requiredSections scopeGlob], schema_path)
    fail_at(schema_path, 'unsupported schemaVersion') unless @schema['schemaVersion'] == 1 && @schema['kind'] == 'constitution-rule'
    fail_at(schema_path, 'invalid categories') unless @schema['categories'] == CATEGORIES
    fail_at(schema_path, 'invalid statuses') unless @schema['statuses'] == STATUSES
    fail_at(schema_path, 'invalid frontmatterFields') unless @schema['frontmatterFields'] == FIELDS
    fail_at(schema_path, 'invalid requiredFields') unless @schema['requiredFields'] == %w[schemaVersion kind id revision title category status scope createdOn createdBy]
    fail_at(schema_path, 'invalid requiredSections') unless @schema['requiredSections'] == %w[Rule Rationale Application]
    fail_at(schema_path, 'unsupported scopeGlob') unless @schema['scopeGlob'] == 'segment-star-v1'
    scan
    digest = tree_digest(File.join(@base, 'constitution/framework'))
    fail_at(manifest_path, 'frameworkDigest drift') unless digest == @manifest['frameworkDigest']
    resolve
  end

  def date?(value)
    text = value.is_a?(Date) ? value.iso8601 : value
    text.is_a?(String) && text.match?(/\A\d{4}-\d{2}-\d{2}\z/) && Date.iso8601(text).iso8601 == text
  rescue Date::Error
    false
  end

  def tree_digest(tree)
    fail_at(tree, 'missing rule tree') unless File.directory?(tree) && !File.symlink?(tree)
    files = Dir.glob(File.join(tree, '**/*'), File::FNM_DOTMATCH).select { |p| File.file?(p) || File.symlink?(p) }.sort
    digest = Digest::SHA256.new
    files.each do |path|
      fail_at(path, 'symlink is not allowed') if File.symlink?(path)
      name = path.delete_prefix("#{tree}/")
      digest.update(name.b).update("\0").update(File.binread(path)).update("\0")
    end
    digest.hexdigest
  end

  def scan
    %w[framework project].each do |source|
      tree = File.join(@base, 'constitution', source)
      fail_at(tree, 'missing rule tree') unless File.directory?(tree) && !File.symlink?(tree)
      CATEGORIES.each do |category|
        dir = File.join(tree, category)
        fail_at(dir, 'missing category directory') unless File.directory?(dir) && !File.symlink?(dir)
      end
      Dir.glob(File.join(tree, '**/*'), File::FNM_DOTMATCH).sort.each do |path|
        next if File.directory?(path) && !File.symlink?(path)
        next if File.basename(path) == '.gitkeep' && CATEGORIES.include?(File.basename(File.dirname(path)))
        fail_at(path, 'symlink is not allowed') if File.symlink?(path)
        fail_at(path, 'unexpected file') unless File.file?(path) && path.end_with?('.md') && CATEGORIES.include?(File.basename(File.dirname(path)))
        parse_rule(path, source)
      end
    end
    pairs = @rules.group_by { |r| [r[:data]['id'], r[:data]['revision']] }
    pairs.each_value { |items| fail_at(items.last[:path], 'duplicate id/revision', items.last[:data]['id']) if items.length > 1 }
    @by_pair = pairs.transform_values(&:first)
    @rules.group_by { |r| r[:data]['id'] }.each_value do |items|
      active = items.count { |r| r[:data]['status'] == 'active' }
      fail_at(items.first[:path], 'multiple active revisions', items.first[:data]['id']) if active > 1
      fail_at(items.first[:path], 'id reused across sources or categories', items.first[:data]['id']) if items.map { |r| [r[:source], r[:data]['category']] }.uniq.length > 1
    end
  end

  def parse_rule(path, source)
    bytes = File.binread(path)
    fail_at(path, 'invalid UTF-8') unless bytes.force_encoding('UTF-8').valid_encoding?
    match = bytes.match(/\A---\r?\n(.*?)\r?\n---\r?\n(.*)\z/m)
    fail_at(path, 'missing YAML frontmatter') unless match
    front, body = match.captures
    fail_at(path, 'frontmatter byte limit exceeded') if front.bytesize > @manifest['limits']['frontmatterBytes']
    data = YAML.safe_load(front, permitted_classes: [Date], aliases: false)
    fail_at(path, 'frontmatter must be a mapping') unless data.is_a?(Hash)
    exact_keys(data, @schema['frontmatterFields'], @schema['requiredFields'], path)
    id = data['id']
    fail_at(path, 'invalid id') unless id.is_a?(String) && id.match?(/\A[a-z][a-z0-9]*(?:-[a-z0-9]+)*\z/)
    fail_at(path, 'invalid revision', id) unless data['revision'].is_a?(Integer) && data['revision'].positive?
    fail_at(path, 'filename must embed id and revision', id) unless File.basename(path) == "#{id}-r#{data['revision']}.md"
    fail_at(path, 'unsupported schemaVersion or kind', id) unless data['schemaVersion'] == @schema['schemaVersion'] && data['kind'] == @schema['kind']
    fail_at(path, 'invalid category', id) unless data['category'] == File.basename(File.dirname(path))
    fail_at(path, 'invalid status', id) unless STATUSES.include?(data['status'])
    %w[title createdBy].each { |key| fail_at(path, "invalid #{key}", id) unless data[key].is_a?(String) && !data[key].strip.empty? }
    fail_at(path, 'invalid createdOn', id) unless date?(data['createdOn'])
    validate_scope(path, id, data['scope'])
    %w[extends supersedes].each { |key| validate_refs(path, id, data[key]) if data.key?(key) }
    if source == 'framework'
      fail_at(path, 'framework rule must be active', id) unless data['status'] == 'active'
      fail_at(path, 'framework approval provenance mismatch', id) unless data['installationApproval'] == @manifest['installationApproval']
    elsif data['status'] == 'active'
      fail_at(path, 'active project rule lacks user approval metadata', id) unless data['approvedBy'] == 'user' && date?(data['approvedOn'])
    end
    limit = @manifest['limits'][data['category'] == 'workflow' ? 'workflow' : 'default']
    fail_at(path, 'body byte limit exceeded', id) if body.bytesize > limit['bodyBytes']
    fail_at(path, 'body word limit exceeded', id) if body.scan(/\S+/).length > limit['bodyWords']
    heads = body.scan(/^## (.+?)\s*$/).flatten
    fail_at(path, 'required sections missing or out of order', id) unless heads.first(3) == @schema['requiredSections']
    sections = body.split(/^## .+?\s*$/).drop(1)
    fail_at(path, 'required section is empty', id) if sections.first(3).any? { |section| section.strip.empty? }
    @rules << { path: path, source: source, data: data, digest: Digest::SHA256.hexdigest(bytes) }
  rescue Psych::Exception => e
    fail_at(path, "invalid YAML: #{e.message.lines.first.strip}")
  end

  def validate_scope(path, id, scope)
    fail_at(path, 'invalid scope', id) unless scope.is_a?(Hash)
    if scope == { 'repository' => true }
      return
    end
    fail_at(path, 'invalid scope', id) unless scope.keys == ['paths'] && scope['paths'].is_a?(Hash)
    paths = scope['paths']
    fail_at(path, 'invalid paths scope', id) unless (paths.keys - %w[include exclude]).empty? && paths['include'].is_a?(Array) && !paths['include'].empty? && (paths['exclude'].nil? || paths['exclude'].is_a?(Array))
    (paths['include'] + (paths['exclude'] || [])).each do |pattern|
      valid = pattern.is_a?(String) && !pattern.empty? && !pattern.start_with?('/') && !pattern.include?('\\') && pattern.split('/').all? { |part| !%w[. ..].include?(part) && (part == '**' || (!part.include?('**') && part.match?(/\A[a-zA-Z0-9_.*-]+\z/))) }
      fail_at(path, "invalid scope pattern #{pattern.inspect}", id) unless valid
    end
  end

  def validate_refs(path, id, refs)
    fail_at(path, 'references must be a list', id) unless refs.is_a?(Array) && !refs.empty?
    refs.each do |ref|
      fail_at(path, 'reference must have exact id and revision', id) unless ref.is_a?(Hash) && ref.keys.sort == %w[id revision] && ref['id'].is_a?(String) && ref['revision'].is_a?(Integer) && ref['revision'].positive?
    end
    fail_at(path, 'duplicate reference', id) unless refs.map { |r| [r['id'], r['revision']] }.uniq.length == refs.length
  end

  def resolve
    graph = {}
    replacements = Hash.new { |h, k| h[k] = [] }
    @rules.each do |rule|
      data = rule[:data]
      pair = [data['id'], data['revision']]
      graph[pair] = []
      %w[extends supersedes].each do |field|
        (data[field] || []).each do |ref|
          target = [ref['id'], ref['revision']]
          fail_at(rule[:path], "dangling #{field} #{target.join('@')}", data['id']) unless @by_pair.key?(target)
          graph[pair] << target
          replacements[target] << rule if field == 'supersedes' && data['status'] == 'active'
        end
      end
      fail_at(rule[:path], 'same target extended and superseded', data['id']) unless graph[pair].uniq.length == graph[pair].length
    end
    visiting = {}
    visited = {}
    walk = lambda do |pair|
      fail_at(@by_pair[pair][:path], 'relationship cycle', pair.first) if visiting[pair]
      return if visited[pair]
      visiting[pair] = true
      graph[pair].each { |target| walk.call(target) }
      visiting.delete(pair)
      visited[pair] = true
    end
    graph.keys.sort.each { |pair| walk.call(pair) }
    replacements.each do |target, rules|
      fail_at(rules.last[:path], "multiple effective replacements of #{target.join('@')}", rules.last[:data]['id']) if rules.length > 1
    end
    @rules.each do |rule|
      rule[:effective] = rule[:data]['status'] == 'active' && !replacements.key?([rule[:data]['id'], rule[:data]['revision']])
    end
  end

  def index
    { 'indexVersion' => 1, 'rules' => @rules.sort_by { |r| [r[:data]['id'], r[:data]['revision'], r[:source]] }.map do |r|
      d = r[:data]
      { 'id' => d['id'], 'revision' => d['revision'], 'source' => r[:source], 'category' => d['category'], 'status' => d['status'], 'effective' => r[:effective], 'path' => relative(r[:path]), 'sha256' => r[:digest] }
    end }
  end

  def check_index
    path = File.join(@base, 'constitution/index.yaml')
    fail_at(path, 'missing index; run rebuild-index') unless File.file?(path)
    fail_at(path, 'stale index; run rebuild-index') unless yaml_file(path) == index
  end

  def rebuild
    path = File.join(@base, 'constitution/index.yaml')
    tempfile = Tempfile.new('.index-', File.dirname(path))
    begin
      tempfile.write(YAML.dump(index))
      tempfile.flush
      tempfile.fsync
      tempfile.close
      File.rename(tempfile.path, path)
    ensure
      tempfile.close!
    end
  end

  def inspect_effective(paths)
    check_index
    paths.each { |path| raise ArgumentError, "invalid target path #{path.inspect}" if path.start_with?('/') || path.split('/').include?('..') }
    selected = @rules.select { |r| r[:effective] && (paths.empty? || paths.any? { |path| applies?(r[:data]['scope'], path) }) }
    puts YAML.dump({ 'rules' => selected.sort_by { |r| [r[:data]['id'], r[:data]['revision']] }.map { |r| { 'id' => r[:data]['id'], 'revision' => r[:data]['revision'], 'path' => relative(r[:path]) } } })
  end

  def applies?(scope, path)
    return true if scope['repository'] == true
    patterns = scope['paths']
    patterns['include'].any? { |glob| glob_match?(glob, path) } && !(patterns['exclude'] || []).any? { |glob| glob_match?(glob, path) }
  end

  def glob_match?(glob, path)
    parts = glob.split('/')
    target = path.split('/')
    matcher = lambda do |i, j|
      return j == target.length if i == parts.length
      return matcher.call(i + 1, j) || (j < target.length && matcher.call(i, j + 1)) if parts[i] == '**'
      return false if j == target.length
      regex = Regexp.new("\\A#{Regexp.escape(parts[i]).gsub('\\*', '[^/]*')}\\z")
      regex.match?(target[j]) && matcher.call(i + 1, j + 1)
    end
    matcher.call(0, 0)
  end
end

begin
  command = ARGV.shift
  raise ArgumentError, 'usage: validate-constitution validate|rebuild-index|inspect-effective [relative paths...]' unless %w[validate rebuild-index inspect-effective].include?(command)
  raise ArgumentError, 'unexpected arguments' unless command == 'inspect-effective' || ARGV.empty?
  root = File.expand_path('../..', __dir__)
  constitution = Constitution.new(root)
  constitution.load_inputs
  case command
  when 'validate' then constitution.check_index
  when 'rebuild-index' then constitution.rebuild
  when 'inspect-effective' then constitution.inspect_effective(ARGV)
  end
rescue InvalidConstitution => e
  warn e.message
  exit 1
rescue ArgumentError, SystemCallError => e
  warn e.message
  exit 2
end
