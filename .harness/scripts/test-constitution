#!/usr/bin/env ruby
# frozen_string_literal: true

require 'minitest/autorun'
require 'tmpdir'
require 'fileutils'
require 'yaml'

class ConstitutionTest < Minitest::Test
  SOURCE = File.expand_path('../..', __dir__)

  def setup
    @temp = Dir.mktmpdir('constitution-test-')
    FileUtils.cp_r(File.join(SOURCE, '.harness'), File.join(@temp, '.harness'))
    @script = File.join(@temp, '.harness/scripts/validate-constitution')
  end

  def teardown
    FileUtils.remove_entry(@temp)
  end

  def run_script(*args)
    require 'open3'
    Open3.capture3(@script, *args)
  end

  def project_rule(id, status: 'draft', extra: '', scope: 'repository: true')
    path = File.join(@temp, ".harness/repository/#{id}-r1.md")
    front = [
      '---', 'schemaVersion: 1', 'kind: constitution-rule', "id: #{id}",
      'revision: 1', "title: #{id}", 'category: repository',
      "status: #{status}", 'scope:', "  #{scope}",
      'createdOn: 2026-09-21', 'createdBy: user', 'origin: project', extra.strip, '---'
    ].reject(&:empty?).join("\n")
    File.write(path, "#{front}\n## Rule\nDo the thing.\n\n## Rationale\nThere is a reason.\n\n## Application\nApply it.\n")
    path
  end

  def project_workflow(id, status: 'draft', loading: 'on_demand', extra: '', scope: 'repository: true')
    path = File.join(@temp, ".harness/workflow/#{id}-r1.md")
    front = [
      '---', 'schemaVersion: 1', 'kind: constitution-rule', "id: #{id}",
      'revision: 1', "title: #{id}", 'category: workflow',
      "status: #{status}", 'scope:', "  #{scope}", "contextLoading: #{loading}",
      'createdOn: 2026-09-21', 'createdBy: user', 'origin: project', extra.strip, '---'
    ].reject(&:empty?).join("\n")
    File.write(path, "#{front}\n## Rule\nDo the thing.\n\n## Rationale\nThere is a reason.\n\n## Application\nApply it.\n")
    path
  end

  def test_clean_install_and_stable_rebuild
    assert_equal 0, run_script('validate')[2].exitstatus
    index = File.binread(File.join(@temp, '.harness/index.yaml'))
    result = run_script('rebuild-index')
    assert_equal 0, result[2].exitstatus, result[1]
    assert_equal index, File.binread(File.join(@temp, '.harness/index.yaml'))
    out, = run_script('inspect-effective')
    assert_equal 19, YAML.safe_load(out)['rules'].length
    assert_includes out, '.harness/workflow/rule-current-truth-r1.md'
    assert_includes out, '.harness/workflow/rule-workflow-entry-r1.md'
    assert_includes out, '.harness/workflow/rule-intent-r1.md'
    assert_includes out, '.harness/workflow/rule-risk-router-r2.md'
    assert_includes out, '.harness/workflow/rule-direct-r2.md'
    assert_includes out, '.harness/workflow/rule-research-r1.md'
    assert_includes out, '.harness/workflow/rule-explore-r1.md'
    assert_includes out, '.harness/workflow/rule-spike-r1.md'
    assert_includes out, '.harness/workflow/rule-plan-r2.md'
    assert_includes out, '.harness/workflow/rule-plan-epic-r1.md'
    assert_includes out, '.harness/workflow/rule-plan-story-r1.md'
    assert_includes out, '.harness/workflow/rule-plan-task-r1.md'
    assert_includes out, '.harness/workflow/rule-execute-r2.md'
    assert_includes out, '.harness/workflow/rule-proof-of-work-r1.md'
    refute File.exist?(File.join(@temp, '.harness/current-truth.md'))
    %w[rule-current-truth rule-risk-router rule-direct rule-plan rule-plan-epic rule-plan-story rule-plan-task rule-execute rule-proof-of-work].each do |id|
      assert_equal 'on_demand', YAML.safe_load(index)['rules'].find { |rule| rule['id'] == id }['contextLoading']
    end
  end

  def test_context_and_independent_workflow_lookups
    context = YAML.safe_load(run_script('inspect-context', 'docs/a.md')[0])['rules']
    assert_equal 7, context.length
    assert_equal %w[rule-authority rule-governance rule-intent rule-repository rule-safety rule-verification rule-workflow-entry], context.map { |rule| rule['id'] }
    refute context.any? { |rule| %w[rule-current-truth rule-risk-router rule-direct rule-research rule-explore rule-spike rule-plan rule-plan-epic rule-plan-story rule-plan-task rule-execute rule-proof-of-work].include?(rule['id']) }
    %w[rule-current-truth rule-risk-router rule-direct rule-research rule-explore rule-spike rule-plan rule-plan-epic rule-plan-story rule-plan-task rule-execute rule-proof-of-work].each do |id|
      rules = YAML.safe_load(run_script('inspect-workflow', id, 'docs/a.md')[0])['rules']
      assert_equal [id], rules.map { |rule| rule['id'] }
    end

    effective = YAML.safe_load(run_script('inspect-effective')[0])['rules']
    assert_equal 19, effective.length
    assert_includes effective.map { |rule| rule['id'] }, 'rule-current-truth'
    assert_includes effective.map { |rule| rule['id'] }, 'rule-risk-router'
  end

  def test_framework_workflow_revisions_remain_auditable
    rules = YAML.safe_load(File.binread(File.join(@temp, '.harness/index.yaml')))['rules']
    %w[rule-direct rule-plan rule-risk-router rule-execute].each do |id|
      legacy = rules.find { |rule| rule['id'] == id && rule['revision'] == 1 }
      current = rules.find { |rule| rule['id'] == id && rule['revision'] == 2 }
      assert_equal 'superseded', legacy['status']
      refute legacy['effective']
      assert_equal true, current['effective']
    end
  end

  def test_superseded_rule_requires_an_active_replacement
    path = project_rule('project-old', status: 'superseded')
    assert File.exist?(path)
    assert_equal 1, run_script('rebuild-index')[2].exitstatus
  end

  def test_workflow_selection_errors_do_not_emit_partial_output
    [['missing-workflow'], ['rule-repository'], ['rule-intent'], ['rule-direct', '/tmp/a'], ['rule-direct', '']].each do |args|
      out, err, status = run_script('inspect-workflow', *args)
      assert_equal 2, status.exitstatus, err
      assert_empty out
      refute_empty err
    end
  end

  def test_workflow_replacement_extensions_and_loading_compatibility
    project_workflow('project-direct', status: 'active', extra: "approvedOn: 2026-09-21\napprovedBy: user\nsupersedes: [{id: rule-direct, revision: 2}]\n")
    project_workflow('project-direct-extension', status: 'active', extra: "approvedOn: 2026-09-21\napprovedBy: user\nextends: [{id: project-direct, revision: 1}]\n")
    project_workflow('project-direct-transitive', status: 'active', extra: "approvedOn: 2026-09-21\napprovedBy: user\nextends: [{id: project-direct-extension, revision: 1}]\n")
    assert_equal 0, run_script('rebuild-index')[2].exitstatus
    rules = YAML.safe_load(run_script('inspect-workflow', 'rule-direct', 'docs/a.md')[0])['rules']
    assert_equal %w[project-direct project-direct-extension project-direct-transitive], rules.map { |rule| rule['id'] }

    project_rule('invalid-loading', extra: "extends: [{id: rule-direct, revision: 1}]\n")
    assert_equal 1, run_script('rebuild-index')[2].exitstatus
  end

  def test_workflow_scope_mismatch_and_nested_lookup
    project_workflow('nested-workflow', status: 'active', extra: "approvedOn: 2026-09-21\napprovedBy: user\n", scope: "paths:\n    include: ['docs/**']\n    exclude: ['docs/private/**']")
    assert_equal 0, run_script('rebuild-index')[2].exitstatus
    out, _err, status = run_script('inspect-workflow', 'nested-workflow', 'crates/a.rs')
    assert_equal 2, status.exitstatus
    assert_empty out
    out, _err, status = run_script('inspect-workflow', 'nested-workflow', 'docs/private/a.md')
    assert_equal 2, status.exitstatus
    assert_empty out
    rules = YAML.safe_load(run_script('inspect-workflow', 'nested-workflow', 'docs/a.md')[0])['rules']
    assert_equal ['nested-workflow'], rules.map { |rule| rule['id'] }
  end

  def test_draft_is_indexed_but_not_effective
    project_rule('project-draft')
    result = run_script('rebuild-index')
    assert_equal 0, result[2].exitstatus, result[1]
    out, = run_script('inspect-effective')
    refute_includes out, 'project-draft'
    assert_includes File.read(File.join(@temp, '.harness/index.yaml')), 'project-draft'
  end

  def test_active_project_rule_needs_approval
    path = project_rule('project-active', status: 'active')
    assert_equal 1, run_script('rebuild-index')[2].exitstatus
    File.write(path, File.read(path).sub("---\n## Rule", "approvedOn: 2026-09-21\napprovedBy: user\n---\n## Rule"))
    result = run_script('rebuild-index')
    assert_equal 0, result[2].exitstatus, result[1]
    out, = run_script('inspect-effective')
    assert_includes out, 'project-active'
  end

  def test_references_and_scope
    path = project_rule('project-scoped', status: 'active', extra: "approvedOn: 2026-09-21\napprovedBy: user\nextends: [{id: rule-repository, revision: 1}]\n", scope: "paths:\n    include: ['docs/**/*.md']\n    exclude: ['docs/private/**']")
    assert File.exist?(path)
    result = run_script('rebuild-index')
    assert_equal 0, result[2].exitstatus, result[1]
    assert_includes run_script('inspect-effective', 'docs/a.md')[0], 'project-scoped'
    refute_includes run_script('inspect-effective', 'docs/private/a.md')[0], 'project-scoped'
    assert_includes run_script('inspect-effective', 'docs/a.md')[0], 'rule-repository'
  end

  def test_invalid_canonical_input_keeps_previous_index
    index_path = File.join(@temp, '.harness/index.yaml')
    before = File.binread(index_path)
    project_rule('broken', extra: "supersedes: [{id: absent, revision: 1}]\n")
    assert_equal 1, run_script('rebuild-index')[2].exitstatus
    assert_equal before, File.binread(index_path)
  end

  def test_missing_schema_and_digest_drift
    schema = File.join(@temp, '.harness/schema.yaml')
    File.delete(schema)
    assert_equal 1, run_script('validate')[2].exitstatus
    FileUtils.cp(File.join(SOURCE, '.harness/schema.yaml'), schema)
    rule = Dir[File.join(@temp, '.harness/authority/*.md')].first
    File.open(rule, 'a') { |f| f.puts 'extra' }
    assert_equal 1, run_script('validate')[2].exitstatus
  end

  def test_stale_and_missing_index
    index = File.join(@temp, '.harness/index.yaml')
    File.open(index, 'a') { |f| f.puts 'unexpected: true' }
    assert_equal 1, run_script('validate')[2].exitstatus
    assert_equal 0, run_script('rebuild-index')[2].exitstatus
    File.delete(index)
    assert_equal 1, run_script('validate')[2].exitstatus
    assert_equal 0, run_script('rebuild-index')[2].exitstatus
  end

  def test_duplicate_and_cycle_references
    path = project_rule('project-one')
    copy = File.join(@temp, '.harness/repository/duplicate-r1.md')
    FileUtils.cp(path, copy)
    assert_equal 1, run_script('rebuild-index')[2].exitstatus
    File.delete(copy)
    File.write(path, File.read(path).sub("---\n## Rule", "extends: [{id: project-one, revision: 1}]\n---\n## Rule"))
    assert_equal 1, run_script('rebuild-index')[2].exitstatus
  end

  def test_body_and_frontmatter_limits
    path = project_rule('project-large')
    File.open(path, 'a') { |f| f.write(('word ' * 1001)) }
    assert_equal 1, run_script('rebuild-index')[2].exitstatus
    File.write(path, File.read(path).sub('word ' * 1001, ''))
    File.write(path, File.read(path).sub('title: project-large', "title: #{'界' * 3000}"))
    assert_equal 1, run_script('rebuild-index')[2].exitstatus
  end

  def test_missing_manifest_and_invocation_exit_codes
    manifest = File.join(@temp, '.harness/manifest.yaml')
    File.delete(manifest)
    assert_equal 1, run_script('validate')[2].exitstatus
    assert_equal 2, run_script('unknown')[2].exitstatus
  end

  def test_supersedes_exact_framework_revision
    project_rule('project-replacement', status: 'active', extra: "approvedOn: 2026-09-21\napprovedBy: user\nsupersedes: [{id: rule-repository, revision: 1}]\n")
    assert_equal 0, run_script('rebuild-index')[2].exitstatus
    out = run_script('inspect-effective')[0]
    assert_includes out, 'project-replacement'
    refute_includes out, 'rule-repository'
  end
end
